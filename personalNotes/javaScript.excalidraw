      "index": "ac",
      "roundness": null,
      "seed": 891127970,
      "version": 126,
      "versionNonce": 1715161534,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777216953255,
      "link": null,
      "locked": false,
      "text": "[] + []     // \"\"\n[] + {}     // \"[object Object]\"\n{} + []     // 0 ❗ (weird parsing case)\n\n[] == false     // true ❗\nBoolean([])    //true\n[] == \"\"        // true\n[0] == 0        // true\n\n|| and && (don’t return boolean returns value) \n\n?? (nullish coalescing)  null??5 returns 5\nworks for null and undefined\n\n\"length\" in [] // true\n    checks property existence, not value\n",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[] + []     // \"\"\n[] + {}     // \"[object Object]\"\n{} + []     // 0 ❗ (weird parsing case)\n\n[] == false     // true ❗\nBoolean([])    //true\n[] == \"\"        // true\n[0] == 0        // true\n\n|| and && (don’t return boolean returns value) \n\n?? (nullish coalescing)  null??5 returns 5\nworks for null and undefined\n\n\"length\" in [] // true\n    checks property existence, not value\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
