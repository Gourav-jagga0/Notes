    {
      "id": "rxc1t3UuMsX0qAIvRBGLl",
      "type": "text",
      "x": 1963.6516021092734,
      "y": 1035.4127171682908,
      "width": 502.72369384765625,
      "height": 467.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
