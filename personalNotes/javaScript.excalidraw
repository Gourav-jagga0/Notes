      "seed": 662237154,
      "version": 430,
      "versionNonce": 2024318754,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777195079601,
      "link": null,
      "locked": false,
      "text": "string -> \n    \"😊\".length // 2 ❗\n    typeof \"hi\" // \"string\"\n    typeof new String(\"hi\") // \"object\"\n    let s = \"abc\";\n    s[0] = \"z\";\n    console.log(s); // \"abc\"\n     can create sting with `${varName}`\n    \nnumber-> \n    NaN === NaN // false ❗\n    0.1 + 0.2 === 0.3 // false ❗\n    Number.MAX_SAFE_INTEGER // 2^53 - 1 precision lost \n    1 / 0 // Infinity\n    -1 / 0 // -Infinity\n\nbigint-> const x = 12345678901234567890n;\n    can not mix with number 1n + 1 // ❌ TypeError\n    5n / 2n // 2n\n    \n\nboolean-> false in only false 0,-0,0n,\"\",null,undefined,NaN\n    ,undefined,symbol,null else true even in \"false\"\n    \n\nundefined -> typeof undefined // \"undefined\"\n\nsymbol -> identifies any thing unique\n    Symbol(\"a\") === Symbol(\"a\") // false\nnull -> typeof null // \"object\" ❗\n    null == undefined // true\n    null === undefined // false",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "string -> \n    \"😊\".length // 2 ❗\n    typeof \"hi\" // \"string\"\n    typeof new String(\"hi\") // \"object\"\n    let s = \"abc\";\n    s[0] = \"z\";\n    console.log(s); // \"abc\"\n     can create sting with `${varName}`\n    \nnumber-> \n    NaN === NaN // false ❗\n    0.1 + 0.2 === 0.3 // false ❗\n    Number.MAX_SAFE_INTEGER // 2^53 - 1 precision lost \n    1 / 0 // Infinity\n    -1 / 0 // -Infinity\n\nbigint-> const x = 12345678901234567890n;\n    can not mix with number 1n + 1 // ❌ TypeError\n    5n / 2n // 2n\n    \n\nboolean-> false in only false 0,-0,0n,\"\",null,undefined,NaN\n    ,undefined,symbol,null else true even in \"false\"\n    \n\nundefined -> typeof undefined // \"undefined\"\n\nsymbol -> identifies any thing unique\n    Symbol(\"a\") === Symbol(\"a\") // false\nnull -> typeof null // \"object\" ❗\n    null == undefined // true\n    null === undefined // false",
      "autoResize": true,
      "lineHeight": 1.25
    },
