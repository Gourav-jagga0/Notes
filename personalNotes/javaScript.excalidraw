    {
      "id": "6mFhSuwnYQwONUXGgmZrw",
      "type": "text",
      "x": 1216.27673874961,
      "y": 1623.192995760176,
      "width": 467.2310791015625,
      "height": 495,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aZ",
      "roundness": null,
      "seed": 1994148962,
      "version": 102,
      "versionNonce": 1528275198,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777214054448,
      "link": null,
      "locked": false,
      "text": "String->  String({}) // \"[object Object]\" ❗\n    String([1,2,3]) // \"1,2,3\"\n    String([])      // \"\" ❗\n    String(Symbol(\"id\")) // \"Symbol(id)\" ✅\n    String(-0) // \"0\"\nNumber-> Number(\"\") // 0 ❗\n    Number(\"   \") // 0 ❗\n    Number(\"123abc\") // NaN\n    Number([])      // 0 ❗\n    Number([1])     // 1\n    Number([1,2])   // NaN ❗\n    Number({}) // NaN\n    Number(null)      // 0\n    Number(undefined) // NaN ❗\nBoolean-> Boolean(\"false\") // true ❗\n    Boolean([])      // true ❗\n    Boolean({})      // true ❗\n    Boolean(\"0\")     // true ❗",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "String->  String({}) // \"[object Object]\" ❗\n    String([1,2,3]) // \"1,2,3\"\n    String([])      // \"\" ❗\n    String(Symbol(\"id\")) // \"Symbol(id)\" ✅\n    String(-0) // \"0\"\nNumber-> Number(\"\") // 0 ❗\n    Number(\"   \") // 0 ❗\n    Number(\"123abc\") // NaN\n    Number([])      // 0 ❗\n    Number([1])     // 1\n    Number([1,2])   // NaN ❗\n    Number({}) // NaN\n    Number(null)      // 0\n    Number(undefined) // NaN ❗\nBoolean-> Boolean(\"false\") // true ❗\n    Boolean([])      // true ❗\n    Boolean({})      // true ❗\n    Boolean(\"0\")     // true ❗",
      "autoResize": true,
      "lineHeight": 1.25
    },
