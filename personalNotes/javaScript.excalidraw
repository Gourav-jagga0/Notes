      "updated": 1777191913137,
      "link": null,
      "locked": false,
      "text": "for (var i = 0; i < 3; i++) {\n  setTimeout(() => console.log(i), 0);\n}\n// Output: 3 3 3 ❗\n\nfor (let i = 0; i < 3; i++) {\n  (() => console.log(i), 0);\n}\n// Output: 0 1 2 ✅",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "for (var i = 0; i < 3; i++) {\n  setTimeout(() => console.log(i), 0);\n}\n// Output: 3 3 3 ❗\n\nfor (let i = 0; i < 3; i++) {\n  (() => console.log(i), 0);\n}\n// Output: 0 1 2 ✅",
      "autoResize": true,
      "lineHeight": 1.25
    },
