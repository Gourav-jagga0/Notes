    {
      "id": "WedGrOVBQNjFBPPX4kCey",
      "type": "text",
      "x": 339.161066532135,
      "y": 1069.6005554199219,
      "width": 643.392333984375,
      "height": 880,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
